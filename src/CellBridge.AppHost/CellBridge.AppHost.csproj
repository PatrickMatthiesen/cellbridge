<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>CellBridge.Development.AppHost</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0-preview.1.26520.1" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0-preview.1.26520.1" />
    <PackageReference Include="Aspire.Hosting.Python" Version="17.0.0-preview.1.26520.1" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0-preview.1.26520.1" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <DefineConstants>$(DefineConstants);CELLBRIDGE_SQLSERVER</DefineConstants>
    <Description>SQL Server runtime for native workspace Lists with built-in and host authorization, typed queries, list paging, views, audit and atomic schema and record operations.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations/InitialListsStorage.sql" />
    <ProjectReference Include="../CellBridge.Lists/CellBridge.Lists.csproj" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.2.26504.105" PrivateAssets="all" />
    <Compile Include="../SharedLists/**/*.cs" Link="Persistence/%(RecursiveDir)%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="CellBridge.SqlServer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../docs/lists-package-readme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>

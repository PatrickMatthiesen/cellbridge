<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>SQL Server document state and content storage with explicit migrations for CellBridge.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CellBridge/CellBridge.csproj" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" />
    <Compile Include="../SharedStorage/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="CellBridge.SqlServer.Tests" />
  </ItemGroup>
</Project>

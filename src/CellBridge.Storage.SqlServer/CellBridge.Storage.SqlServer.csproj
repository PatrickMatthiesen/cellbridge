<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>SQL Server document state and content storage with explicit migrations for CellBridge.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CellBridge/CellBridge.csproj" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.2.26504.105" PrivateAssets="all" />
    <Compile Include="../SharedStorage/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="CellBridge.SqlServer.Tests" />
  </ItemGroup>
</Project>

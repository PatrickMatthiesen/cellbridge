<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <CellBridgePackageVersion Condition="'$(CellBridgePackageVersion)' == ''">0.1.0-beta.2</CellBridgePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CellBridge.AspNetCore" Version="$(CellBridgePackageVersion)" />
    <PackageReference Include="CellBridge.Storage.InMemory" Version="$(CellBridgePackageVersion)" />
    <PackageReference Include="CellBridge.Storage.PostgreSql" Version="$(CellBridgePackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Setup/**;aspire/**" />
    <Content Remove="Setup/**;aspire/**" />
    <None Remove="Setup/**;aspire/**" />
  </ItemGroup>
</Project>

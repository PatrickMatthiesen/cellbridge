<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../src/CellBridge.AspNetCore/CellBridge.AspNetCore.csproj" />
    <ProjectReference Include="../../src/CellBridge.Storage.InMemory/CellBridge.Storage.InMemory.csproj" />
    <ProjectReference Include="../../src/CellBridge.Storage.PostgreSql/CellBridge.Storage.PostgreSql.csproj" />
    <ProjectReference Include="../../src/CellBridge.Storage.FileSystem/CellBridge.Storage.FileSystem.csproj" />
    <ProjectReference Include="../../tools/CellBridge.Storage.ProcessProbe/CellBridge.Storage.ProcessProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/CellBridge.Storage.Portability/CellBridge.Storage.Portability.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../CellBridge.TestFixtures/CellBridge.TestFixtures.csproj" />
    <ProjectReference Include="../../src/CellBridge.OfficeInspectors/CellBridge.OfficeInspectors.csproj" />
    <None Include="../../testdata/sharepoint/fixtures/save_reopen/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/api/excel-save-20260928.bin" Link="Fixtures/excel-save-20260928.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/api/word-save-current.bin" Link="Fixtures/word-save-current.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/api/word-save-fresh*.bin" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/protocol/MS-FSSHTTP-FSSHTTPB.wsdl" Link="Fixtures/MS-FSSHTTP-FSSHTTPB.wsdl" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
    <EmbeddedResource Include="../../testdata/storage/postgresql-schema6.sql" LogicalName="CellBridge.Storage.Tests.Fixtures.PostgreSqlSchema6.sql" />
  </ItemGroup>
  <Target Name="CopyProcessProbe" AfterTargets="Build">
    <ItemGroup><ProbeFiles Include="../../tools/CellBridge.Storage.ProcessProbe/bin/$(Configuration)/net10.0/**/*" /></ItemGroup>
    <Copy SourceFiles="@(ProbeFiles)" DestinationFiles="@(ProbeFiles->'$(OutDir)Probe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup><Compile Include="../CellBridge.TestIdentity.cs" Link="TestIdentity.cs" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" /></ItemGroup>
  <ItemGroup><Compile Include="../CellBridge.GraphFixture.cs" Link="GraphFixture.cs" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CellBridge.Authentication/CellBridge.Authentication.csproj" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../CellBridge.TestInfrastructure/CellBridge.TestInfrastructure.csproj" /></ItemGroup>
</Project>

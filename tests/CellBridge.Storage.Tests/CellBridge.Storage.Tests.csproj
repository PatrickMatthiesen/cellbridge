<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../src/CellBridge.AspNetCore/CellBridge.AspNetCore.csproj" />
    <ProjectReference Include="../../src/CellBridge.Storage.InMemory/CellBridge.Storage.InMemory.csproj" />
    <ProjectReference Include="../../src/CellBridge.Storage.PostgreSql/CellBridge.Storage.PostgreSql.csproj" />
    <ProjectReference Include="../../src/CellBridge.Storage.FileSystem/CellBridge.Storage.FileSystem.csproj" />
    <ProjectReference Include="../../src/CellBridge.Storage.Conformance/CellBridge.Storage.Conformance.csproj" />
    <ProjectReference Include="../../tools/CellBridge.Storage.ProcessProbe/CellBridge.Storage.ProcessProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/CellBridge.Web/CellBridge.Web.csproj" />
    <None Include="../../testdata/sharepoint/fixtures/save_reopen/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
  <Target Name="CopyProcessProbe" AfterTargets="Build">
    <ItemGroup><ProbeFiles Include="../../tools/CellBridge.Storage.ProcessProbe/bin/$(Configuration)/net10.0/**/*" /></ItemGroup>
    <Copy SourceFiles="@(ProbeFiles)" DestinationFiles="@(ProbeFiles->'$(OutDir)Probe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup><Compile Include="../CellBridge.TestIdentity.cs" Link="TestIdentity.cs" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" /></ItemGroup>
  <ItemGroup><Compile Include="../CellBridge.GraphFixture.cs" Link="GraphFixture.cs" /></ItemGroup>
</Project>

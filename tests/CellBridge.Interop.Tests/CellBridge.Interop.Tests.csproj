<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Vendored 2015 Interop-TestSuites sources predate nullable annotations. -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8073;CS8632</NoWarn>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="*.cs" />
    <None Include="../../testdata/api/excel-save-20260928.bin" Link="Fixtures/excel-save-20260928.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/api/word-enable-editing.xml" Link="Fixtures/word-enable-editing.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../testdata/sharepoint/fixtures/save_reopen/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../CellBridge.GraphFixture.cs" Link="GraphFixture.cs" />
    <Compile Include="MicrosoftProtocol\**\*.cs" />
    <Compile Remove="MicrosoftProtocol\FssHttpD\**\*.cs" />
    <ProjectReference Include="..\..\src\CellBridge\CellBridge.csproj" />
    <ProjectReference Include="..\..\src\CellBridge.FssHttpB\CellBridge.FssHttpB.csproj" />
    <ProjectReference Include="../../src/CellBridge.AspNetCore/CellBridge.AspNetCore.csproj" />
    <ProjectReference Include="../../src/CellBridge.Storage.InMemory/CellBridge.Storage.InMemory.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0-preview.1.26520.1" />
    <ProjectReference Include="../CellBridge.TestInfrastructure/CellBridge.TestInfrastructure.csproj" />
    <ProjectReference Include="../CellBridge.TestFixtures/CellBridge.TestFixtures.csproj" />
  </ItemGroup>
</Project>

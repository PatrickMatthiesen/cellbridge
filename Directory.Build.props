<Project>
  <PropertyGroup>
    <Version>0.1.0-beta.1</Version>
    <CellBridgePackageVersion Condition="'$(CellBridgePackageVersion)' == ''">$(Version)</CellBridgePackageVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>CellBridge contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PatrickMatthiesen/cellbridge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Experimental Office document synchronization through MS-FSSHTTP and MS-FSSHTTPB.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs/package-readme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
